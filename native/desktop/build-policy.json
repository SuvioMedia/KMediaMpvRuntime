        "replace": {
          "-Dpulse=disabled": "-Dpulse=enabled"
        },
        "append": []
      }
    },
    "macos": {
      "mpv": {
        "replace": {
          "-Dcoreaudio=disabled": "-Dcoreaudio=enabled",
          "-Dgl=disabled": "-Dgl=enabled",
          "-Dcocoa=disabled": "-Dcocoa=enabled",
          "-Dvideotoolbox-gl=disabled": "-Dvideotoolbox-gl=enabled",
          "-Dvideotoolbox-pl=disabled": "-Dvideotoolbox-pl=enabled",
          "-Dvulkan=disabled": "-Dvulkan=enabled"
        },
        "append": [
          "-Dgl-cocoa=enabled"
        ]
      },
      "libplacebo": {
        "replace": {
          "-Dglslang=disabled": "-Dglslang=enabled",
          "-Dvulkan=disabled": "-Dvulkan=enabled"
        },
        "append": [
          "-Dvk-proc-addr=enabled"
        ]
      }
    },
    "windows": {
      "mpv": {
        "replace": {
          "-Dwasapi=disabled": "-Dwasapi=enabled",
          "-Dwin32-threads=disabled": "-Dwin32-threads=enabled",
          "-Dgl=disabled": "-Dgl=enabled",
          "-Dplain-gl=disabled": "-Dplain-gl=enabled"
        },
        "append": [
          "-Dd3d-hwaccel=enabled"
        ]
      },
      "ffmpeg": {
        "replace": {},
        "append": [
          "--disable-pthreads",
          "--enable-w32threads",
          "--extra-ldflags=-no-pthread",
          "--extra-libs=-Wl,-Bstatic -lwinpthread -Wl,-Bdynamic,--exclude-libs,libwinpthread.a"
        ]
      },
      "libplacebo": {
        "replace": {},
        "append": [
          "-Dc_link_args=-no-pthread -static-libgcc -static-libstdc++ -Wl,--major-os-version,10 -Wl,--minor-os-version,0 -Wl,-Bstatic,-lstdc++,-lwinpthread,-Bdynamic,--exclude-libs,libwinpthread.a",
          "-Dcpp_link_args=-no-pthread -static-libgcc -static-libstdc++ -Wl,--major-os-version,10 -Wl,--minor-os-version,0 -Wl,-Bstatic,-lstdc++,-lwinpthread,-Bdynamic,--exclude-libs,libwinpthread.a"
        ]
      }
    }
